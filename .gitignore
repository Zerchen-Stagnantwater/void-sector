# void-sector .gitignore
.DS_Store
Thumbs.db
*.log
node_modules/

# Dependency directories
node_modules/
/packages/*/node_modules/

# TypeScript build outputs
dist/
/packages/*/dist/
*.tsbuildinfo

# Development and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# Operating system files
.DS_Store
Thumbs.db

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs and editors configuration
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

